{
    "name": "vdhicts/xml-validator",
    "description": "Validate your XML easily to a XSD schema",
    "license": "MIT",
    "authors": [
        {
            "name": "Dick van der Heiden",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-libxml": "*",
        "ext-xmlreader": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "symplify/easy-coding-standard": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Vdhicts\\XmlValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vdhicts\\XmlValidator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "code-style:check": "vendor/bin/ecs",
        "code-style:fix": "vendor/bin/ecs --fix",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test:no-coverage": "vendor/bin/phpunit --no-coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
